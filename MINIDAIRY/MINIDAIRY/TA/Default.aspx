        <!-- Application Process -->
    <section class="section" style="background: var(--bg-light);" id="application">
        <div class="container">
            <h2 class="section-title" data-aos="fade-up">விண்ணப்ப செயல்முறை</h2>
            <div class="process-timeline">
                <div class="timeline-item" data-aos="fade-right" data-aos-delay="100">
                    <div class="timeline-number">1</div>
                    <div class="timeline-content">
 <h4>ஆன்லைன் விண்ணப்பம்</h4>
 <p>மினி பால் பண்ணை திட்டத்திற்கான தனிப்பட்ட ஆன்லைன் தளத்தின் மூலம் உங்கள் விண்ணப்பத்தை சமர்ப்பிக்கவும். தேவையானால் கால்நடை மருத்துவர், பால் சங்க செயலாளர் அல்லது விரிவாக்க அதிகாரியிடமிருந்து உதவி பெறலாம்.</p>
                    </div>
                </div>
                <div class="timeline-item" data-aos="fade-left" data-aos-delay="200">
                    <div class="timeline-number">2</div>
                    <div class="timeline-content">
 <h4>ஆவணங்கள் சமர்ப்பித்தல்</h4>
 <p>ஆதார் அட்டை, பான் அட்டை, குடும்ப அட்டை, வங்கி பாஸ்புக், விண்ணப்பதாரரின் பாஸ்போர்ட் அளவு புகைப்படங்கள், சிட்டா & அடங்கல் மற்றும் சங்க உறுப்பினர் சான்றிதழ் ஆகிய தேவையான ஆவணங்களை பதிவேற்றவும்.</p>
                    </div>
                </div>
                <div class="timeline-item" data-aos="fade-right" data-aos-delay="300">
                    <div class="timeline-number">3</div>
                    <div class="timeline-content">
 <h4>விண்ணப்ப பரிசீலனை</h4>
 <p>விண்ணப்பங்கள் நியமிக்கப்பட்ட குழு உறுப்பினர்களால் பரிசீலிக்கப்பட்டு ஆன்லைன் தளத்தின் மூலம் வங்கிகளுக்கு அனுப்பப்படும். நிலை மேம்படுத்தலுக்கான SMS அறிவிப்புகள் அனுப்பப்படும்.</p>
                    </div>
                </div>
                <div class="timeline-item" data-aos="fade-left" data-aos-delay="400">
                    <div class="timeline-number">4</div>
                    <div class="timeline-content">
 <h4>கடன் அனுமதி</h4>
 <p>வங்கி விண்ணப்பத்தை செயல்படுத்தி நிதி வழங்கும். வங்கி மற்றும் பால் சங்க செயலாளருடன் மூவுரு ஒப்பந்தத்தில் கையொப்பமிட வேண்டும்.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

